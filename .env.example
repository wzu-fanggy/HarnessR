# Set the path to your private copy using ORION_ENV_FILE. Never commit the filled file.
ORION_AGENT_PROVIDER=deepseek
ORION_AGENT_MODEL=deepseek-v4-flash
ORION_AGENT_API_KEY=
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
